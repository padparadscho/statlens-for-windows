{
  "file_types": {
    "XML": ["axaml", "xaml"]
  },
  "languages": {
    "XML": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "bash",
          "arguments": [
            "-c",
            "TMP=$(mktemp --suffix=.axaml) && cat > \"$TMP\" && $HOME/.dotnet/tools/xstyler --write-to-stdout -f \"$TMP\" 2>/dev/null | tail -c +4 && rm \"$TMP\""
          ]
        }
      }
    }
  }
}
