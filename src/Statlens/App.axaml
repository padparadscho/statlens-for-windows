<Application
    x:Class="Statlens.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="StatCardBackgroundBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="StatCardBorderBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="RankBadgeBackgroundBrush" Color="#33FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="StatCardBackgroundBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="StatCardBorderBrush" Color="#1F000000" />
                    <SolidColorBrush x:Key="RankBadgeBackgroundBrush" Color="#1F000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Statlens/Styles/Controls.axaml" />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Clicked="OnTrayIconClicked" ToolTipText="Statlens">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Click="OnExitClicked" Header="Exit" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

</Application>
