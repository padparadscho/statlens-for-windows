<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Statlens.ViewModels"
        xmlns:controls="using:Statlens.Controls"
        xmlns:converters="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="360"
        x:Class="Statlens.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Statlens"
        Width="260"
        Height="360"
        CanResize="False"
        WindowDecorations="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Mica"
        Topmost="{Binding IsPinned, Mode=TwoWay}">

    <Panel Background="Transparent" PointerPressed="OnRootPointerPressed">
        <Panel.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Change"
                          ToggleType="CheckBox"
                          IsChecked="{Binding ShowChange, Mode=TwoWay}" />
                <MenuItem Header="Sparkline"
                          ToggleType="CheckBox"
                          IsChecked="{Binding ShowSparkline, Mode=TwoWay}" />
                <MenuItem Header="Volume"
                          ToggleType="CheckBox"
                          IsChecked="{Binding ShowVolume, Mode=TwoWay}" />
                <MenuItem Header="High/Low"
                          ToggleType="CheckBox"
                          IsChecked="{Binding ShowHighLow, Mode=TwoWay}" />
                <MenuItem Header="Supply"
                          ToggleType="CheckBox"
                          IsChecked="{Binding ShowSupply, Mode=TwoWay}" />
                <MenuItem Header="Market Cap"
                          ToggleType="CheckBox"
                          IsChecked="{Binding ShowMarketCap, Mode=TwoWay}" />
            </ContextMenu>
        </Panel.ContextMenu>

        <StackPanel Margin="10" Spacing="6">
            <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto">
                <Image Width="24"
                       Height="24"
                       VerticalAlignment="Center"
                       Source="avares://Statlens/Assets/Stronghold.png"
                       Stretch="Uniform" />

                <StackPanel Grid.Column="1"
                            Margin="7,0,0,0"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="{Binding CurrentAssetData.Name}"
                                   VerticalAlignment="Center" />
                        <Border Background="#33FFFFFF"
                                CornerRadius="7"
                                IsVisible="{Binding HasRank}"
                                Margin="5,0,0,0"
                                Padding="5,1"
                                VerticalAlignment="Center">
                            <TextBlock FontSize="8.5"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       LineHeight="10"
                                       Text="{Binding RankText}"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <TextBlock FontSize="9"
                               Margin="0,1,0,0"
                               Opacity="0.45"
                               Text="{Binding CurrentAssetData.Symbol}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Classes="headerIconButton"
                            Command="{Binding RefreshAssetDataCommand}"
                            ToolTip.Tip="Refresh">
                        <TextBlock Classes="iconGlyph" Text="&#xE72C;" />
                    </Button>
                    <Button Classes="headerIconButton"
                            Command="{Binding OpenOnCoinGeckoCommand}"
                            ToolTip.Tip="View on CoinGecko">
                        <TextBlock Classes="iconGlyph" Text="&#xE774;" />
                    </Button>
                    <Button Classes="headerIconButton"
                            Command="{Binding TogglePinCommand}"
                            ToolTip.Tip="Always on top">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Classes="iconGlyph"
                                       IsVisible="{Binding !IsPinned}"
                                       Text="&#xE718;" />
                            <TextBlock Classes="iconGlyph"
                                       IsVisible="{Binding IsPinned}"
                                       Text="&#xE77A;" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock HorizontalAlignment="Center"
                       Foreground="OrangeRed"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding ErrorMessage}" />

            <Grid Margin="0,8,0,0" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{Binding PriceBrush}"
                           Text="{Binding CurrentAssetData.Price, StringFormat='${0:N4}'}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Border Grid.Column="1"
                        Background="{Binding ChangeBadgeBrush}"
                        CornerRadius="6"
                        Height="21"
                        IsVisible="{Binding ShowChange}"
                        Margin="6,0,0,0"
                        Padding="7,0"
                        VerticalAlignment="Center">
                    <TextBlock FontSize="10.5"
                               FontWeight="Bold"
                               Foreground="{Binding ChangeBrush}"
                               HorizontalAlignment="Center"
                               Text="{Binding CurrentAssetData.DailyChangePercentage, StringFormat='{}{0:+0.00;-0.00}%'}"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>

            <TextBlock HorizontalAlignment="Center"
                       IsVisible="{Binding ShowVolume}"
                       Text="{Binding CurrentAssetData.DailyVolume, StringFormat='Vol: {0:N0}'}" />

            <StackPanel Margin="0,8,0,0" IsVisible="{Binding ShowHighLow}">
                <TextBlock Classes="caption" Text="24H HIGH / LOW" />
                <controls:RangeBarControl Height="10" Percent="{Binding HighLowPercent}">
                    <controls:RangeBarControl.FillBrush>
                        <SolidColorBrush Color="{DynamicResource SystemAccentColor}" />
                    </controls:RangeBarControl.FillBrush>
                </controls:RangeBarControl>
                <Grid Margin="0,2,0,0" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               FontSize="8.5"
                               Opacity="0.55"
                               Text="{Binding FormattedDailyLow}" />
                    <TextBlock Grid.Column="1"
                               FontSize="8.5"
                               Opacity="0.55"
                               Text="{Binding FormattedDailyHigh}" />
                </Grid>
            </StackPanel>

            <StackPanel Margin="0,8,0,0" IsVisible="{Binding ShowSupply}">
                <TextBlock Classes="caption" Text="CIRCULATING SUPPLY" />
                <controls:RangeBarControl Height="10" Percent="{Binding SupplyPercent}">
                    <controls:RangeBarControl.FillBrush>
                        <SolidColorBrush Color="{DynamicResource SystemAccentColor}" />
                    </controls:RangeBarControl.FillBrush>
                </controls:RangeBarControl>
                <Grid Margin="0,2,0,0" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               FontSize="8.5"
                               Opacity="0.55"
                               Text="{Binding FormattedCirculatingSupply}" />
                    <TextBlock Grid.Column="1"
                               FontSize="8.5"
                               Opacity="0.55"
                               Text="{Binding FormattedTotalSupply}" />
                </Grid>
            </StackPanel>

            <TextBlock HorizontalAlignment="Center"
                       IsVisible="{Binding ShowMarketCap}"
                       Text="{Binding CurrentAssetData.MarketCap, StringFormat='MCap: {0:N0}'}" />

            <controls:SparklineControl Height="46"
                                        Margin="-10,8,-10,-9"
                                        IsPositive="{Binding IsChangePositive}"
                                        IsVisible="{Binding ShowSparkline}"
                                        Prices="{Binding CurrentAssetData.Sparkline}" />
        </StackPanel>
    </Panel>

</Window>
